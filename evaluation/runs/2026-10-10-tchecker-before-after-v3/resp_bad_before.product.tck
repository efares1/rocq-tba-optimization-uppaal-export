system:product

event:p
event:q
event:other
event:tau
event:go
event:back

clock:1:P_x0
clock:1:SYS_x0
clock:1:SYS_x1
clock:1:z
clock:1:t

process:P
location:P:lid0{initial:}
location:P:lid2{labels:accP}
location:P:lid4{labels:accP}
edge:P:lid4:lid4:p{}
edge:P:lid4:lid4:q{}
edge:P:lid4:lid4:other{}
edge:P:lid2:lid4:p{provided:P_x0>5}
edge:P:lid2:lid4:q{provided:P_x0>5}
edge:P:lid2:lid4:other{provided:P_x0>5}
edge:P:lid2:lid2:p{}
edge:P:lid2:lid2:other{}
edge:P:lid0:lid2:p{do:P_x0=0}
edge:P:lid0:lid0:p{}
edge:P:lid0:lid0:q{}
edge:P:lid0:lid0:other{}

process:SYS
location:SYS:ls0{initial:}
location:SYS:ls1{invariant:SYS_x0<=6}
edge:SYS:ls0:ls1:p{provided:SYS_x1>0:do:SYS_x0=0;SYS_x1=0}
edge:SYS:ls0:ls0:other{provided:SYS_x1>0:do:SYS_x1=0}
edge:SYS:ls1:ls1:other{provided:SYS_x1>0&&SYS_x0<6:do:SYS_x1=0}
edge:SYS:ls1:ls0:q{provided:SYS_x1>0&&SYS_x0>=1:do:SYS_x1=0}

process:Z
location:Z:z0{initial:}
edge:Z:z0:z0:p{provided:z>0:do:z=0}
edge:Z:z0:z0:q{provided:z>0:do:z=0}
edge:Z:z0:z0:other{provided:z>0:do:z=0}

process:D
location:D:wait{initial:}
location:D:seen{}
location:D:div{committed::labels:div}
edge:D:seen:div:back{provided:t>=1}
edge:D:div:wait:go{do:t=0}
edge:D:wait:seen:p{}
edge:D:seen:seen:p{}
edge:D:wait:seen:q{}
edge:D:seen:seen:q{}
edge:D:wait:seen:other{}
edge:D:seen:seen:other{}

sync:P@p:SYS@p:Z@p:D@p
sync:P@q:SYS@q:Z@q:D@q
sync:P@other:SYS@other:Z@other:D@other
