digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L1;
  L1 [shape=circle, label="L1"];
  L2 [shape=circle, label="L2\nx0 <= 5"];
  L4 [shape=doublecircle, label="L4"];
  L1 -> L2 [label="other\nx0 := 0"];
  L2 -> L4 [label="x0 <= 5 && x0 >= 2: p"];
  L2 -> L2 [label="x0 <= 5: other"];
  L4 -> L4 [label="any"];
}
